# Patches are applied with git apply against VS Code's checkout. With CRLF line endings, the hunk for a file
# with no trailing newline (code-icon.svg) no longer matches, so a Windows checkout with core.autocrlf=true
# would break setup. Keep them LF everywhere; git apply still matches them against a CRLF working tree.
*.patch eol=lf

# Shell scripts run on Linux runners and in containers, where a CR at a line end breaks them.
*.sh eol=lf

# Golden test output is compared byte for byte with what the generators print ("\n"). A Windows checkout with
# core.autocrlf=true turned the expected files to CRLF and the Mermaid/PlantUML export tests failed there.
editor/extensions/flow-view/test/expected/** text eol=lf
editor/extensions/flow-view/test/types-expected/** text eol=lf
editor/extensions/flow-view/test/table-expected/** text eol=lf
editor/extensions/flow-view/test/migration-expected/** text eol=lf
editor/extensions/flow-view/test/canvas-expected/** text eol=lf

# The session fixtures are transcripts (one JSON object a line) whose last line is cut off on purpose; the tests split them on "\n".
editor/extensions/flow-agent/test/fixtures/** text eol=lf
