{
	"$schema": "https://schema.tauri.app/config/2",
	"productName": "Insilode Agents",
	"version": "0.0.0",
	"identifier": "dev.insilode.agents",
	"build": { "frontendDist": "../ui/dist" },
	"app": {
		"withGlobalTauri": true,
		"windows": [{ "label": "main", "title": "Insilode Agents", "width": 1100, "height": 680, "x": 0, "y": 0 }],
		"security": { "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost" }
	},
	"bundle": { "active": false, "icon": ["icons/icon.png"] }
}
