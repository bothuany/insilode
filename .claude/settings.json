{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm run arch:*)",
      "Bash(npm run semgrep:*)",
      "Bash(npm run sonar:*)",
      "Bash(npm test:*)",
      "Bash(npm run typecheck:*)",
      "Bash(npm run build:*)",
      "Bash(node --test:*)",
      "Bash(dotnet build analyzer:*)",
      "Bash(semgrep --test:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)"
    ],
    "deny": [
      "Read(./tools/sonarqube/.token)",
      "Edit(./editor/vscode/**)"
    ]
  },
  "worktree": { "baseRef": "head" },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [{ "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-paths.mjs\"", "timeout": 10 }]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [{ "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/indent-check.mjs\"", "timeout": 10 }]
      }
    ],
    "SubagentStart": [
      {
        "matcher": "^implementer$",
        "hooks": [{ "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/implementer-gate.mjs\"", "timeout": 30 }]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "^implementer$",
        "hooks": [{ "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/implementer-gate.mjs\"", "timeout": 300 }]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/arch-on-stop.mjs\"", "timeout": 120 },
          { "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/typecheck-on-stop.mjs\"", "timeout": 180 }
        ]
      }
    ]
  }
}
