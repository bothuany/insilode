+	const add = (n, text) => { if (n) { const s = el('span'); s.append(el('b', '', n), ' ' + text); h.append(s); } };
+	if (c) { add(c.needs, 'need you'); add(c.working, 'working'); add(c.done, 'done'); }
+	if (!h.childElementCount) { h.append(el('span', '', data.items.length ? data.items.length + ' agents' : 'No agents')); }
+	h.append(controls());
+	return h;
+}
+function render() {
+	if (!data) { return; }
+	for (const [k, v] of Object.entries(data.colors)) { document.documentElement.style.setProperty('--' + k, v); }
+	document.body.className = 'size-' + data.size + (data.attached ? ' attached' : '') + (data.notch ? ' notch' : '') + (dragging ? ' dragging' : '');
+	root.style.opacity = String(data.opacity);
+	const list = !data.minimized && (data.style === 'list' || hover);
+	const box = el('div', 'box' + (list ? ' list' : '') + (data.minimized ? ' mini' : ''));
+	let shell = box;
+	// Without padding the page is exactly the wings (or the dot beside the housing): the window is sized to what it reports.
+	root.className = data.notch && !list ? 'bare' : '';
+	if (data.minimized) {
+		// Only the agent colour and its state: the avatar of the most urgent agent, and a tooltip with the rest.
+		const lead = data.items[0] || { key: 'none', cli: 'custom', state: 'idle' };
+		box.append(avatar(lead));
+		box.title = data.items.length ? data.items.map(i => i.name + ': ' + label(i)).join('\\n') : 'No agents';
+		box.addEventListener('click', () => { if (!swallow) { say({ type: 'expand' }); } });
+		if (data.notch) {
+			// The dot sits on the right of the housing, as tall as it: the housing's width is left empty before it.
+			box.classList.add('r');
+			box.style.cssText = 'box-sizing: border-box; padding: 0 0.55em; height: ' + data.notch + 'px';
+			const gap = el('span');
+			gap.style.width = data.gap + 'px';
+			shell = el('div', 'wings');
+			shell.append(gap, box);
+		}
+		const kept = new Map([...root.querySelectorAll('.avw[data-k]')].map(a => [a.dataset.k, a]));
+		box.querySelectorAll('.avw[data-k]').forEach(a => { const old = kept.get(a.dataset.k); if (old) { kept.delete(a.dataset.k); a.replaceWith(old); } });
+		root.replaceChildren(shell);
+		requestAnimationFrame(report);
+		return;
+	}
+	if (list) {
+		if (data.notch) { box.style.paddingTop = data.notch + 'px'; }
+		box.append(head());
+		if (!data.items.length) { box.append(el('div', 'row empty', 'No agents')); }
+		data.items.forEach(i => box.append(row(i)));
+	} else {
+		const dots = el('div', 'dots');
+		data.items.slice(0, 6).forEach(i => dots.append(avatar(i)));
+		if (!data.items.length) { dots.append(avatar({ key: 'none', cli: 'custom', state: 'idle' })); }
+		// Beside the camera housing the island is two boxes with the housing, left transparent, between them: the left wing's
+		// content ends where the housing starts, the right wing's starts where it ends, and each is as tall as the housing.
+		const left = data.notch ? box : undefined;
+		const right = data.notch ? el('div', 'box r') : box;
+		if (left) {
+			left.classList.add('l');
+			left.append(dots);
+			for (const wing of [left, right]) { wing.style.height = data.notch + 'px'; }
+			shell = el('div', 'wings');
+			const gap = el('span');
+			gap.style.width = data.gap + 'px';
+			shell.append(left, gap, right);
+		} else {
+			box.append(dots);
+		}
+		const lead = data.items[0];
+		if (data.style === 'pill') {
+			if (!data.notch) { right.append(el('span', 'sep')); }
+			if (lead) {
+				const l = el('span', 'lead');
+				l.append(el('span', 'name', lead.name), el('span', 'verb', label(lead)));
+				if (data.items.length > 1) { l.append(el('span', 'more', '+' + (data.items.length - 1))); }
+				right.append(l, meta(lead));
+			} else {
+				right.append(el('span', 'verb', 'No agents'));
+			}
+		}
+		right.append(controls());
+	}
+	if (!list) { shell.querySelectorAll('.box').forEach(b => { b.title = data.moved ? 'Drag to move, double-click to put it back' : 'Drag to move'; }); }
+	// An avatar that did not change keeps its element, so its animation runs on instead of restarting with each update.
+	const kept = new Map([...root.querySelectorAll('.avw[data-k]')].map(a => [a.dataset.k, a]));
+	shell.querySelectorAll('.avw[data-k]').forEach(a => { const old = kept.get(a.dataset.k); if (old) { kept.delete(a.dataset.k); a.replaceWith(old); } });
+	root.replaceChildren(shell);
+	requestAnimationFrame(report);
+}
+function report() {
+	const r = root.getBoundingClientRect();
+	const size = { type: 'size', width: Math.ceil(r.width), height: Math.ceil(r.height) };
+	if (root.className === 'bare') {
+		// Beside the camera housing the window is sized from the wings: the main process puts each against the housing.
+		const wing = sel => { const e = root.querySelector(sel); return e ? Math.ceil(e.getBoundingClientRect().width) : 0; };
+		size.left = wing('.box.l');
+		size.right = wing('.box.r');
+	}
+	const key = [size.width, size.height, size.left, size.right].join('x');
+	if (key !== reported) {
+		reported = key;
+		say(size);
+	}
+}
+setInterval(() => {
+	document.querySelectorAll('[data-since]').forEach(e => { e.textContent = elapsed(Number(e.dataset.since)); });
+	report();
+}, 1000);
+// The dot has no list to open: leaving it alone keeps a press on it from losing its element to a repaint.
+root.addEventListener('mouseenter', () => { if (!hover) { hover = true; if (data && !data.minimized) { render(); } } });
+root.addEventListener('mouseleave', () => { if (hover) { hover = false; if (data && !data.minimized) { render(); } } });
+// Dragging: the page only says when it starts, moves and ends; the main process reads the pointer and moves the window.
+root.addEventListener('pointerdown', e => {
+	if (e.button !== 0 || e.target.closest('button')) { return; }
+	press = { x: e.screenX, y: e.screenY };
+});
+root.addEventListener('pointermove', e => {
+	if (!press) { return; }
+	if (!dragging) {
+		if (Math.hypot(e.screenX - press.x, e.screenY - press.y) < 4) { return; }
+		dragging = true;
+		// Captured only once it is a drag: a captured pointer would send the click of a press on an agent or on the dot to the root.
+		root.setPointerCapture(e.pointerId);
+		document.body.classList.add('dragging');
+		say({ type: 'drag-start' });
+		return;
+	}
+	say({ type: 'drag' });
+});
+function endPress() {
+	if (dragging) {
+		say({ type: 'drag-end' });
+		swallow = true;
+		setTimeout(() => { swallow = false; }, 60);
+	}
+	press = undefined;
+	dragging = false;
+	document.body.classList.remove('dragging');
+}
+root.addEventListener('pointerup', endPress);
+root.addEventListener('pointercancel', endPress);
+root.addEventListener('lostpointercapture', endPress);
+root.addEventListener('dblclick', e => { if (data && data.moved && !e.target.closest('button, .row')) { say({ type: 'reset' }); } });
+window.insilodeRender = model => { data = model; render(); };
+</script></body></html>`;
