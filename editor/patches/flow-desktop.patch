+/*---------------------------------------------------------------------------------------------
+ *  Insilode: the desktop agent status overlay. One small always-on-top window for the whole app that
+ *  draws the agents every Insilode window pushes (merged per window, like the Dock badge).
+ *
+ *  It never takes focus: it is created hidden and not focusable (an NSPanel on macOS), it appears
+ *  with showInactive() only, and nothing here focuses or shows any window. A click on an agent is
+ *  sent back to the window that owns it, which brings itself forward: that is the user's gesture.
+ *  test/arch/desktop-focus.test.mjs holds this file to that.
+ *
+ *  The page has no Node, no preload and no network (sandbox, CSP default-src 'none'). Everything
+ *  it shows arrives as data and is set as text. It talks back over console messages with a marker,
+ *  and every navigation and popup is refused.
+ *--------------------------------------------------------------------------------------------*/
+
+import { execFile } from 'child_process';
+import { readFileSync, writeFile } from 'fs';
+import { join } from 'path';
+import { app, BrowserWindow, Display, screen } from 'electron';
+import { Emitter } from '../../../base/common/event.js';
+import { Disposable, toDisposable } from '../../../base/common/lifecycle.js';
+import { isMacintosh } from '../../../base/common/platform.js';
+import { ILogService } from '../../log/common/log.js';
+import { AVATAR_CSS, AVATAR_SCRIPT } from '../common/insilodeAvatars.js';
+import { clampRect, FocusGate, focusWait, INITIAL_GATE, islandAgents, IslandNotch, IslandRect, islandRect, IslandSpot, islandVisible, islandWanted, layoutChanged, nearNotch, observeFocus, parseNotchProbe, readSpot, readUnset, rectToSpot, resetAllowed, resolvePlacement, settleFocus } from '../common/insilodeIsland.js';
+import { IInsilodeOverlayColors, IInsilodeOverlayItem, IInsilodeOverlayOptions, IInsilodeOverlayService, IInsilodeOverlayState } from '../common/insilodeDesktop.js';
+
+/** What the page prefixes its messages with, so an unrelated console line is never taken for one. */
+const MARKER = '\u0001insilode-overlay:';
+const MAX_ITEMS = 40;
+
+const PALETTES: Record<'black' | 'dark' | 'light', IInsilodeOverlayColors> = {
+	black: { background: '#000000', foreground: '#f4f4f6', muted: '#8b8b95', border: 'rgba(255, 255, 255, 0.10)', working: '#8c9bff', approval: '#ffb454', question: '#c58cff', error: '#ff6b6b', done: '#5fe0a1', idle: '#4a4a52' },
+	dark: { background: 'rgba(28, 29, 35, 0.94)', foreground: '#e8e9ee', muted: '#a3a7b5', border: 'rgba(255, 255, 255, 0.12)', working: '#6f86ff', approval: '#ffb454', question: '#c58cff', error: '#ff6b6b', done: '#5fe0a1', idle: '#7d8293' },
+	light: { background: 'rgba(250, 250, 252, 0.96)', foreground: '#1f2128', muted: '#5d6170', border: 'rgba(0, 0, 0, 0.12)', working: '#3b5bdb', approval: '#d9480f', question: '#8e44ad', error: '#d63031', done: '#2b8a3e', idle: '#868e96' },
+};
+
+const DEFAULT_OPTIONS: IInsilodeOverlayOptions = { position: 'top-center', display: 'insilode', style: 'pill', size: 'medium', opacity: 0.95, theme: 'black', autoHide: { noAgents: true, insilodeFocused: true }, avatar: 'gyro' };
+
+/**
+ * macOS only: where the camera housing of each screen is. Electron's Display has no such rectangle, so AppKit is asked
+ * (JXA: no window, no Apple event) for each screen's id (the same number as Electron's `display.id`), frame, top safe area
+ * (the housing's height) and the two strips of the menu bar either side of the housing (macOS 12 and later). The result is
+ * parsed by parseNotchProbe.
+ */
+const NOTCH_PROBE = `ObjC.import('AppKit');
+const out = [];
+const screens = $.NSScreen.screens;
+for (let i = 0; i < screens.count; i++) {
+	const s = screens.objectAtIndex(i);
+	const rect = r => ({ x: r.origin.x, y: r.origin.y, width: r.size.width, height: r.size.height });
