+
+function sanitizeColors(raw: IInsilodeOverlayColors | undefined): IInsilodeOverlayColors | undefined {
+	if (!raw) {
+		return undefined;
+	}
+	const out: Record<string, string> = {};
+	for (const key of Object.keys(PALETTES.dark) as (keyof IInsilodeOverlayColors)[]) {
+		const v = raw[key];
+		if (typeof v !== 'string' || !COLOR.test(v)) {
+			return undefined;
+		}
+		out[key] = v;
+	}
+	return out as unknown as IInsilodeOverlayColors;
+}
+
