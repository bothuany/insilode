index 0000000..a0cb80e
--- /dev/null
+++ b/src/insilodeMigrate.ts
@@ -0,0 +1,234 @@
+/*---------------------------------------------------------------------------------------------
+ *  Insilode: what an Axle install left behind (the product was called Axle until 0.4.x).
+ *
+ *  The settings live in the user data folder (`Axle` under the platform's app data folder) and the
+ *  extensions in the data folder in the home directory (`.axle`). Insilode uses `Insilode` and `.insilode`,
+ *  so the first start copies what is worth keeping, once. The old folders are never touched: an Axle
+ *  that is still installed keeps working, and nothing is lost if the copy has to be redone.
+ *
+ *  Plain TypeScript with no VS Code imports, so the unit test cuts it out of the patch and runs it as it is.
+ *--------------------------------------------------------------------------------------------*/
+
+import * as fs from 'node:fs';
+import * as path from 'node:path';
+
+export const LEGACY_USER_DATA = 'Axle';
+export const LEGACY_DATA_FOLDER = '.axle';
+
+/** Written into a folder made by the migration; the folder is never migrated again, and a half-made copy never carries it. */
+export const MARKER = '.migrated-from-axle';
+
+/** What is copied from the user data folder: settings, keybindings, snippets, global and workspace state (trust included), unsaved backups. Caches and logs are not. */
+const USER_DATA_ENTRIES = ['User', 'Backups', 'storage.json', 'languagepacks.json', 'machineid'];
+
+/**
+ * Per-workspace state and the local history: years of use can leave gigabytes there, and nothing needs them before the first window,
+ * so they are copied after startup (`deferredCopies`), one folder at a time, instead of holding up the start.
+ */
+const DEFERRED_USER_ENTRIES = [path.join('User', 'workspaceStorage'), path.join('User', 'History')];
+
+/** What is copied from the data folder in the home directory. The agent bridge folder is runtime state. */
+const DATA_FOLDER_ENTRIES = ['extensions', 'argv.json'];
+
+export interface MigrationInput {
+	platform: NodeJS.Platform;
+	env: NodeJS.ProcessEnv;
+	home: string;
+	/** The command line after the executable: a user-chosen folder (`--user-data-dir`, `--extensions-dir`) is never replaced. */
+	argv: readonly string[];
+	/** product.json's `nameShort` and `dataFolderName`. */
+	product: { nameShort: string; dataFolderName: string };
+	isPortable: boolean;
+}
+
+export interface MigrationResult {
+	copied: string[];
+	failed: string[];
+}
+
+/** Where VS Code keeps the user data folder: VSCODE_APPDATA, else %APPDATA%, ~/Library/Application Support or $XDG_CONFIG_HOME. */
+export function appDataFolder(i: Pick<MigrationInput, 'platform' | 'env' | 'home'>): string {
+	if (i.env['VSCODE_APPDATA']) {
+		return i.env['VSCODE_APPDATA'];
+	}
+	switch (i.platform) {
+		case 'win32': return i.env['APPDATA'] ?? path.join(i.home, 'AppData', 'Roaming');
+		case 'darwin': return path.join(i.home, 'Library', 'Application Support');
+		default: return i.env['XDG_CONFIG_HOME'] ?? path.join(i.home, '.config');
+	}
+}
+
+const hasFlag = (argv: readonly string[], name: string) => argv.some(a => a === `--${name}` || a.startsWith(`--${name}=`));
+
+/** Text that names the old theme or the old folder: rewritten in the copy, never in the original. */
+export function rewriteSettings(file: 'settings' | 'extensions', text: string): string {
+	if (file === 'settings') {
+		return text.replace(/"Axle (Dark|Light)"/g, '"Insilode $1"');
+	}
+	// extensions.json records where each extension lives, as an absolute path in the old folder.
+	return text.replace(/([\\/])\.axle([\\/])/g, '$1.insilode$2');
+}
+
+function copyEntries(from: string, to: string, entries: readonly string[], skip: readonly string[]): void {
+	const skipped = new Set(skip.map(s => path.join(from, s)));
+	for (const name of entries) {
+		const source = path.join(from, name);
+		if (fs.existsSync(source)) {
+			fs.cpSync(source, path.join(to, name), { recursive: true, filter: src => !skipped.has(path.normalize(src)) });
+		}
+	}
+}
+
+function rewriteIn(file: string, kind: 'settings' | 'extensions'): void {
+	if (!fs.existsSync(file)) {
+		return;
+	}
+	const text = fs.readFileSync(file, 'utf8');
+	const next = rewriteSettings(kind, text);
+	if (next !== text) {
+		fs.writeFileSync(file, next);
+	}
+}
+
+function isRunning(pid: number): boolean {
+	if (!Number.isInteger(pid) || pid <= 0) {
+		return false;
+	}
+	try {
+		process.kill(pid, 0);
+		return true;
+	} catch (e) {
+		// EPERM: the process exists, it belongs to another user.
+		return (e as NodeJS.ErrnoException).code === 'EPERM';
+	}
+}
+
+/** Half-made copies no running start owns: `<to>.migrating` (Insilode 0.5.1 and before) or `<to>.migrating-<pid>` of a process that is gone. */
+function removeStalePartials(to: string): void {
+	const dir = path.dirname(to);
+	const prefix = `${path.basename(to)}.migrating`;
+	let names: string[];
+	try {
+		names = fs.readdirSync(dir);
+	} catch {
+		return;
+	}
+	for (const name of names) {
+		if (name === prefix || (name.startsWith(`${prefix}-`) && !isRunning(Number(name.slice(prefix.length + 1))))) {
+			fs.rmSync(path.join(dir, name), { recursive: true, force: true });
+		}
+	}
+}
+
+/**
+ * Copies `from` to `to` when `to` is missing: into a sibling of this process's own first, then a rename, so `to` is either absent or
+ * whole. Two starts at once (a double click, or a file association and the dock) each copy into their own sibling; the first rename
+ * wins, and the other start drops its copy, which is not a failure.
+ */
+function migrateFolder(from: string, to: string, entries: readonly string[], skip: readonly string[], rewrite: (folder: string) => void, result: MigrationResult): boolean {
+	if (!fs.existsSync(from) || fs.existsSync(to)) {
+		return false;
+	}
+	removeStalePartials(to);
+	const partial = `${to}.migrating-${process.pid}`;
+	try {
+		fs.rmSync(partial, { recursive: true, force: true });
+		fs.mkdirSync(partial, { recursive: true });
+		copyEntries(from, partial, entries, skip);
+		rewrite(partial);
+		fs.writeFileSync(path.join(partial, MARKER), JSON.stringify({ from, at: new Date().toISOString() }) + '\n');
+		fs.renameSync(partial, to);
+		result.copied.push(`${from} -> ${to}`);
+		return true;
+	} catch (e) {
+		fs.rmSync(partial, { recursive: true, force: true });
+		// Another start that renamed its copy first: `to` is whole, which is what this one wanted.
+		if (!fs.existsSync(path.join(to, MARKER))) {
+			result.failed.push(`${from}: ${(e as Error).message}`);
+		}
+		return false;
+	}
+}
+
+const pending: Promise<void>[] = [];
+
+/** Resolves when the copies `migrateLegacyData` left for after startup are done; they never reject (a failure is logged). */
+export function deferredCopies(): Promise<void> {
+	return Promise.all(pending).then(() => undefined);
+}
+
+/**
+ * Copies each folder in `from` (one per workspace, or per file of the local history) to `to`, in the background. Each goes to a sibling
+ * first and is renamed into place only when the app has not made that folder itself in the meantime: a workspace opened before its copy
+ * arrived keeps what the app wrote, and the app never reads a half-copied folder.
+ */
+function copyChildrenLater(from: string, to: string): void {
+	const log = (message: string) => console.error(`Insilode: could not copy data from Axle: ${message}`);
+	pending.push((async () => {
+		let names: string[];
+		try {
+			names = await fs.promises.readdir(from);
+		} catch {
+			return;
+		}
+		await fs.promises.mkdir(to, { recursive: true });
+		for (const name of names) {
+			const target = path.join(to, name);
+			const partial = path.join(to, `.${name}.migrating-${process.pid}`);
+			try {
+				if (fs.existsSync(target)) {
+					continue;
+				}
+				await fs.promises.cp(path.join(from, name), partial, { recursive: true });
+				if (!fs.existsSync(target)) {
+					await fs.promises.rename(partial, target);
+				}
+			} catch (e) {
+				log(`${path.join(from, name)}: ${(e as Error).message}`);
+			} finally {
+				await fs.promises.rm(partial, { recursive: true, force: true });
+			}
+		}
+	})().catch(e => log((e as Error).message)));
+}
+
+/**
+ * Never throws: a start must not fail because an old folder could not be copied. It is tried again at the next start. What can be large
+ * and is not needed to start (DEFERRED_USER_ENTRIES) is copied in the background afterwards; `deferredCopies` says when that is done.
+ */
+export function migrateLegacyData(i: MigrationInput): MigrationResult {
+	const result: MigrationResult = { copied: [], failed: [] };
+	// A build run from source (VSCODE_DEV) works on folders of its own ("Insilode Dev", ".insilode-dev"): it never takes a person's real data.
+	if (i.isPortable || i.env['VSCODE_PORTABLE'] || i.env['VSCODE_DEV']) {
+		return result;
+	}
+	try {
+		if (!hasFlag(i.argv, 'user-data-dir')) {
+			const base = appDataFolder(i);
+			const from = path.join(base, LEGACY_USER_DATA);
+			const to = path.join(base, i.product.nameShort);
+			const made = migrateFolder(from, to, USER_DATA_ENTRIES, DEFERRED_USER_ENTRIES, folder => {
+				rewriteIn(path.join(folder, 'User', 'settings.json'), 'settings');
+				const profiles = path.join(folder, 'User', 'profiles');
+				if (fs.existsSync(profiles)) {
+					for (const p of fs.readdirSync(profiles)) {
+						rewriteIn(path.join(profiles, p, 'settings.json'), 'settings');
+					}
+				}
+			}, result);
+			if (made) {
+				for (const entry of DEFERRED_USER_ENTRIES) {
+					copyChildrenLater(path.join(from, entry), path.join(to, entry));
+				}
+			}
+		}
+		if (!hasFlag(i.argv, 'extensions-dir')) {
+			migrateFolder(path.join(i.home, LEGACY_DATA_FOLDER), path.join(i.home, i.product.dataFolderName), DATA_FOLDER_ENTRIES, [], folder => {
+				rewriteIn(path.join(folder, 'extensions', 'extensions.json'), 'extensions');
+			}, result);
+		}
+	} catch (e) {
+		result.failed.push((e as Error).message);
+	}
+	return result;
+}
