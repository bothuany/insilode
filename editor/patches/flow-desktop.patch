@@ -0,0 +1,81 @@
+/*---------------------------------------------------------------------------------------------
+ *  Insilode: the desktop agent status overlay, shared by the main process (which owns the window) and
+ *  the workbench (which pushes each window's agents). Insilode's Agents extension builds the model
+ *  (editor/extensions/flow-agent/src/desktopModel.ts); every string in it is drawn as text.
+ *--------------------------------------------------------------------------------------------*/
+
+import { Event } from '../../../base/common/event.js';
+import { createDecorator } from '../../instantiation/common/instantiation.js';
+
+export const INSILODE_OVERLAY_CHANNEL = 'insilodeOverlay';
+
+export type InsilodeOverlayItemState = 'working' | 'needs' | 'done' | 'idle';
+export type InsilodeOverlayAttention = 'approval' | 'question' | 'error' | 'done';
+
+export interface IInsilodeOverlayItem {
+	readonly id: string;
+	readonly name: string;
+	readonly cli: string;
+	readonly state: InsilodeOverlayItemState;
+	readonly attention?: InsilodeOverlayAttention;
+	readonly activity?: string;
+	readonly context?: number;
+	readonly usd?: number;
+	/** When it entered this state (epoch ms), for the elapsed time. */
+	readonly since?: number;
+}
+
+export interface IInsilodeOverlayOptions {
+	readonly position: 'top-center' | 'top-left' | 'top-right' | 'bottom-left' | 'bottom-center' | 'bottom-right';
+	readonly display: 'insilode' | 'primary' | 'secondary';
+	readonly style: 'pill' | 'dots' | 'list';
+	readonly size: 'small' | 'medium' | 'large';
+	readonly opacity: number;
+	readonly theme: 'black' | 'editor' | 'dark' | 'light';
+	readonly autoHide: { readonly noAgents: boolean; readonly insilodeFocused: boolean };
+	/** How each agent is drawn (insilodeAvatars.ts). */
+	readonly avatar: 'gyro' | 'pixel';
+	/**
+	 * What the user left unset, which then follows the screen: on a Mac whose display has a camera housing the island is on
+	 * (`enabled`) and stays visible while Insilode is focused (`focused`) unless the user chose otherwise. Absent means both set.
+	 */
+	readonly unset?: { readonly enabled: boolean; readonly focused: boolean };
+}
+
+/** CSS colours, resolved from the window's colour theme when the overlay follows it. */
+export interface IInsilodeOverlayColors {
+	readonly background: string;
+	readonly foreground: string;
+	readonly muted: string;
+	readonly border: string;
+	readonly working: string;
+	readonly approval: string;
+	readonly question: string;
+	readonly error: string;
+	readonly done: string;
+	readonly idle: string;
+}
+
+export interface IInsilodeOverlayState {
+	readonly items: readonly IInsilodeOverlayItem[];
+	readonly counts?: { readonly needs: number; readonly working: number; readonly done: number };
+	readonly options: IInsilodeOverlayOptions;
+}
+
+export const IInsilodeOverlayService = createDecorator<IInsilodeOverlayService>('insilodeOverlayService');
+
+export interface IInsilodeOverlayService {
+	readonly _serviceBrand: undefined;
+
+	/** The user clicked an agent in the overlay: the window that pushed it shows it. */
+	readonly onDidClickAgent: Event<{ readonly windowId: number; readonly id: string }>;
+
+	/** The user pressed the island's close button: the window that pushed last turns the overlay off in its settings. */
+	readonly onDidRequestClose: Event<{ readonly windowId: number }>;
+
+	/**
+	 * This window's agents, or undefined when it has none to show (the overlay is off, or the window goes away). Resolves to
+	 * whether the island is wanted for this window now (an unset setting depends on the screen's camera housing).
+	 */
+	update(windowId: number, state: IInsilodeOverlayState | undefined, colors: IInsilodeOverlayColors | undefined): Promise<boolean>;
+}
diff --git a/src/vs/platform/insilodeDesktop/common/insilodeIsland.ts b/src/vs/platform/insilodeDesktop/common/insilodeIsland.ts
new file mode 100644
index 0000000..3dad038
--- /dev/null
+++ b/src/vs/platform/insilodeDesktop/common/insilodeIsland.ts
@@ -0,0 +1,331 @@
+/*---------------------------------------------------------------------------------------------
+ *  Insilode: the rules of the desktop status island that need no Electron, so they are tested on
+ *  their own (editor/extensions/flow-agent/test/island.test.mjs reads this file out of
+ *  editor/patches/flow-desktop.patch). This file imports nothing.
+ *
+ *  - Position: where the user dropped the island, remembered per display as a fraction of the
+ *    display's width (so a new resolution keeps it in the same place) plus a distance from the
+ *    top, and always clamped back onto a display that exists.
+ *  - Visibility: while an Insilode window has focus the island shows only the other windows' agents that
+ *    work or need you (the focused window has its own dock). Focus moves between windows
+ *    (and through the Alt+Tab switcher) as a blur then a focus, so a change only counts once it
+ *    has lasted a little: switching to it fast, back slower, so that switching does not flicker.
+ *  - The camera housing (the notch) of a MacBook: where it is comes from the macOS probe in the main
+ *    process (parseNotchProbe reads what the probe prints), and the island is two wings around it.
+ *--------------------------------------------------------------------------------------------*/
+
+export interface IslandRect {
+	readonly x: number;
+	readonly y: number;
+	readonly width: number;
+	readonly height: number;
+}
+
+export interface IslandSpot {
+	/** Centre of the island across the display's area, 0 (left edge) to 1 (right edge). */
+	readonly cx: number;
+	/** Distance from the top of the display's area, in pixels. */
+	readonly y: number;
+}
+
+export interface IslandDisplay {
+	readonly id: number;
+	readonly workArea: IslandRect;
+	/** The whole display, menu bar band included: the nearest display is measured to this when it is given. */
+	readonly bounds?: IslandRect;
+}
+
+const finite = (v: unknown): v is number => typeof v === 'number' && Number.isFinite(v);
+
+/** The island moved so that all of it is inside `area` (as much as fits when it is bigger than the area). */
+export function clampRect(rect: IslandRect, area: IslandRect): IslandRect {
+	const width = Math.min(rect.width, area.width);
+	const height = Math.min(rect.height, area.height);
+	const x = Math.min(Math.max(rect.x, area.x), area.x + area.width - width);
+	const y = Math.min(Math.max(rect.y, area.y), area.y + area.height - height);
+	return { x: Math.round(x), y: Math.round(y), width, height };
+}
+
+/** What to remember about a place the user dropped the island at. */
+export function rectToSpot(rect: IslandRect, area: IslandRect): IslandSpot {
+	const cx = area.width > 0 ? (rect.x + rect.width / 2 - area.x) / area.width : 0.5;
+	return { cx: Math.min(1, Math.max(0, cx)), y: Math.max(0, rect.y - area.y) };
+}
+
+/** The island's rectangle for a remembered spot at this size, kept on the display. */
+export function spotToRect(spot: IslandSpot, size: { width: number; height: number }, area: IslandRect): IslandRect {
+	const x = area.x + spot.cx * area.width - size.width / 2;
+	return clampRect({ x, y: area.y + spot.y, width: size.width, height: size.height }, area);
+}
+
+/** A spot read back from a file: anything malformed is no spot. */
+export function readSpot(v: unknown): IslandSpot | undefined {
+	const o = v as { cx?: unknown; y?: unknown } | null | undefined;
+	return o && finite(o.cx) && finite(o.y) ? { cx: Math.min(1, Math.max(0, o.cx)), y: Math.max(0, o.y) } : undefined;
+}
+
+/**
+ * Where the island goes: on the display it was last dropped on while that display is still connected, else on the
+ * display the settings chose, at the remembered spot of that display if it has one. `undefined` means no spot applies and
+ * the settings' own placement is used.
+ */
+export function resolvePlacement(
+	spots: Readonly<Record<string, IslandSpot>>,
+	last: string | undefined,
+	displays: readonly IslandDisplay[],
+	chosen: IslandDisplay,
+): { display: IslandDisplay; spot: IslandSpot } | undefined {
+	const remembered = last === undefined ? undefined : displays.find(d => String(d.id) === last);
+	for (const display of remembered ? [remembered] : [chosen]) {
+		const spot = spots[String(display.id)];
+		if (spot) {
+			return { display, spot };
+		}
+	}
+	return undefined;
+}
+
+/**
+ * Which display holds most of the rectangle (the one the user dropped it on). A rectangle that overlaps no work area (the
+ * attached island sits in the menu bar band, outside every one) belongs to the display nearest its centre, not to the first.
+ */
+export function displayForRect(rect: IslandRect, displays: readonly IslandDisplay[]): IslandDisplay | undefined {
+	let best: IslandDisplay | undefined;
+	let bestArea = 0;
+	for (const d of displays) {
+		const w = Math.min(rect.x + rect.width, d.workArea.x + d.workArea.width) - Math.max(rect.x, d.workArea.x);
+		const h = Math.min(rect.y + rect.height, d.workArea.y + d.workArea.height) - Math.max(rect.y, d.workArea.y);
+		const overlap = w > 0 && h > 0 ? w * h : 0;
+		if (overlap > bestArea) {
+			best = d;
+			bestArea = overlap;
+		}
+	}
+	if (best) {
+		return best;
+	}
+	const cx = rect.x + rect.width / 2;
+	const cy = rect.y + rect.height / 2;
+	let nearest = Infinity;
+	for (const d of displays) {
+		const a = d.bounds ?? d.workArea;
+		const dx = Math.max(a.x - cx, 0, cx - (a.x + a.width));
+		const dy = Math.max(a.y - cy, 0, cy - (a.y + a.height));
+		if (dx * dx + dy * dy < nearest) {
+			best = d;
+			nearest = dx * dx + dy * dy;
+		}
+	}
+	return best;
+}
+
+// --- Placement ----------------------------------------------------------------------------------
+
+/**
+ * The camera housing of a display: where it starts and ends across the display (points from the display's left edge) and
+ * how far down it reaches. Only a display that has one gets a notch; there is no guess for the others.
+ */
+export interface IslandNotch {
+	readonly left: number;
+	readonly right: number;
+	readonly height: number;
+}
+
+const rectOf = (v: unknown): { x: number; width: number } | undefined => {
+	const o = v as { x?: unknown; width?: unknown } | null | undefined;
+	return o && finite(o.x) && finite(o.width) ? { x: o.x, width: o.width } : undefined;
+};
+
+/**
+ * What the macOS probe printed (the JSON of one entry per NSScreen: `id`, `frame`, `top` = safeAreaInsets.top and the two
+ * auxiliaryTop areas, the strips of the menu bar either side of the housing) as the notch of each display that has one, by
+ * display id. Output that is not that, and any screen whose strips do not leave a housing between them, give no notch.
+ */
+export function parseNotchProbe(output: string): Map<number, IslandNotch> {
+	const notches = new Map<number, IslandNotch>();
+	let screens: unknown;
+	try {
+		screens = JSON.parse(output);
+	} catch {
+		return notches;
+	}
+	for (const s of Array.isArray(screens) ? screens : []) {
+		const frame = rectOf(s?.frame);
+		const l = rectOf(s?.auxiliaryTopLeftArea);
+		const r = rectOf(s?.auxiliaryTopRightArea);
+		if (!frame || !l || !r || !finite(s.id) || !finite(s.top)) {
+			continue;
+		}
+		// Only the widths: the strips' coordinates may be in another space than the frame's (a display left of the main one).
+		const left = l.width;
+		const right = frame.width - r.width;
+		if (s.top > 0 && left > 0 && right > left && right < frame.width) {
+			notches.set(s.id, { left, right, height: s.top });
+		}
+	}
+	return notches;
+}
+
+/** The `unset` of the options a window pushed (untrusted): two strict booleans, or none, which means both were set. */
+export function readUnset(v: unknown): { readonly enabled: boolean; readonly focused: boolean } | undefined {
+	const o = v as { enabled?: unknown; focused?: unknown } | null | undefined;
+	return o && typeof o === 'object' ? { enabled: o.enabled === true, focused: o.focused === true } : undefined;
+}
+
+/** Whether a window that pushed agents gets the island: one whose enabled setting is unset wants it only where a display has a camera housing. */
+export function islandWanted(unset: { readonly enabled: boolean } | undefined, hasNotch: boolean): boolean {
+	return !unset?.enabled || hasNotch;
+}
+
+/** Whether a dropped island is close enough to the camera housing to be put back beside it: its centre within `within` points of it. */
+export function nearNotch(rect: IslandRect, notch: IslandNotch, bounds: IslandRect, within = 40): boolean {
+	const cx = rect.x + rect.width / 2;
+	const cy = rect.y + rect.height / 2;
+	const dx = Math.max(bounds.x + notch.left - cx, 0, cx - (bounds.x + notch.right));
+	const dy = Math.max(bounds.y - cy, 0, cy - (bounds.y + notch.height));
+	return Math.hypot(dx, dy) <= within;
+}
+
+/**
+ * Where the island goes. A remembered spot wins; else the settings' corner. The attached island (top-center, no spot)
+ * is one of two things:
+ *  - beside a camera housing (`notch`): two wings, the left one ending where the housing starts and the right one starting
+ *    where it ends, top edge on the display's top edge, as tall as the housing. The page tells how wide each wing wants to
+ *    be (`size.left`, `size.right`), clamped here so that neither runs off the display; without those (the hover list) the
+ *    window is one block with its middle on the housing's.
+ *  - elsewhere: one pill centred directly under the menu bar (the top of `workArea`), never over it.
+ * The others float `margin` inside `workArea`.
+ * shortcut: a wing clamped narrower than its content cuts the content off, when a display is too narrow to hold a wing.
+ */
+export function islandRect(i: {
+	readonly spot: IslandSpot | undefined;
+	readonly attached: boolean;
+	readonly position: string;
+	readonly size: { readonly width: number; readonly height: number; readonly left?: number; readonly right?: number };
+	readonly bounds: IslandRect;
+	readonly workArea: IslandRect;
+	readonly notch?: IslandNotch;
+}): IslandRect {
+	if (i.spot) {
+		return spotToRect(i.spot, i.size, i.workArea);
+	}
+	const { bounds, notch, size } = i;
+	if (i.attached && notch) {
+		if (finite(size.left) && finite(size.right)) {
+			const left = Math.min(Math.max(size.left, 0), notch.left);
+			const right = Math.min(Math.max(size.right, 0), bounds.width - notch.right);
+			return { x: Math.round(bounds.x + notch.left - left), y: bounds.y, width: Math.round(left + notch.right - notch.left + right), height: notch.height };
+		}
+		const width = Math.min(size.width, bounds.width);
+		const x = Math.min(Math.max(bounds.x + (notch.left + notch.right) / 2 - width / 2, bounds.x), bounds.x + bounds.width - width);
+		return { x: Math.round(x), y: bounds.y, width, height: size.height };
+	}
+	const margin = i.attached ? 0 : 10;
+	const { width, height } = size;
+	const [vertical, horizontal] = i.position.split('-');
+	const x = horizontal === 'left' ? i.workArea.x + margin : horizontal === 'right' ? i.workArea.x + i.workArea.width - width - margin : i.workArea.x + (i.workArea.width - width) / 2;
+	const y = vertical === 'top' ? i.workArea.y + margin : i.workArea.y + i.workArea.height - height - margin;
+	return { x: Math.round(x), y: Math.round(y), width, height };
+}
+
+/**
+ * Whether the saved spots are cleared: when the position settings of the window that pushes now are not what the
+ * same window pushed before. Windows differ (a workspace can set its own), so the keys are kept per window; comparing
+ * with whichever window pushed last would clear the spot at every push from the other one.
+ */
+export function layoutChanged(keys: Record<number, string>, windowId: number, key: string): boolean {
+	const before = keys[windowId];
+	keys[windowId] = key;
+	return before !== undefined && before !== key;
+}
+
+/** A double-click puts the island back, but only one that is not the click ending a drag: the drop just happened. */
+export const RESET_AFTER_DROP_MS = 700;
+
+export function resetAllowed(lastDropAt: number | undefined, now: number): boolean {
+	return lastDropAt === undefined || now - lastDropAt >= RESET_AFTER_DROP_MS;
+}
+
+export interface WindowAgents<T> {
+	readonly windowId: number;
+	readonly items: readonly T[];
+}
+
+/**
+ * The agents the island shows. With no Insilode window focused, all of them. While one is focused (`focusedWindowId`)
+ * that window shows its own agents in its dock, so the island is for the other windows' agents that are working or
+ * need you; finished and idle ones stay in their window. Empty means nothing to show (the island hides).
+ */
+export function islandAgents<T extends { readonly state: string }>(windows: readonly WindowAgents<T>[], focusedWindowId: number | undefined): { windowId: number; item: T }[] {
+	const out: { windowId: number; item: T }[] = [];
+	for (const w of windows) {
+		if (w.windowId === focusedWindowId) {
+			continue;
+		}
+		for (const item of w.items) {
+			if (focusedWindowId === undefined || item.state === 'working' || item.state === 'needs') {
+				out.push({ windowId: w.windowId, item });
+			}
+		}
+	}
+	return out;
+}
+
+// --- Visibility ---------------------------------------------------------------------------------
+
+export interface FocusDelays {
+	/** How long Insilode must have been focused before the island hides. */
+	readonly hideMs: number;
+	/** How long no Insilode window must have focus before the island comes back. */
+	readonly showMs: number;
+}
+
+export const FOCUS_DELAYS: FocusDelays = { hideMs: 120, showMs: 400 };
+
+export interface FocusGate {
+	/** Whether an Insilode window has focus, as settled. */
+	readonly focused: boolean;
+	/** A change seen but not yet settled. */
+	readonly pending?: { readonly value: boolean; readonly at: number };
+}
+
+export const INITIAL_GATE: FocusGate = { focused: false };
+
+/** Records what is true now: a change starts a wait, a return to the settled value cancels it. */
+export function observeFocus(gate: FocusGate, focused: boolean, now: number): FocusGate {
+	if (focused === gate.focused) {
+		return gate.pending ? { focused: gate.focused } : gate;
+	}
+	return gate.pending?.value === focused ? gate : { focused: gate.focused, pending: { value: focused, at: now } };
+}
+
+/** Applies a pending change once it has lasted long enough. */
+export function settleFocus(gate: FocusGate, now: number, delays: FocusDelays = FOCUS_DELAYS): FocusGate {
+	const p = gate.pending;
+	if (p && now - p.at >= (p.value ? delays.hideMs : delays.showMs)) {
+		return { focused: p.value };
+	}
+	return gate;
+}
+
+/** Milliseconds until the pending change settles, or undefined when nothing is pending. */
+export function focusWait(gate: FocusGate, now: number, delays: FocusDelays = FOCUS_DELAYS): number | undefined {
+	const p = gate.pending;
+	return p ? Math.max(0, p.at + (p.value ? delays.hideMs : delays.showMs) - now) : undefined;
+}
+
+export interface VisibilityInput {
+	/** Whether islandAgents left anything to show (while an Insilode window has focus that is only other windows' agents). */
+	readonly hasAgents: boolean;
+	readonly autoHide: { readonly noAgents: boolean };
+	/** An Insilode window has focus and the focus rule is on: the island is then only for the others' agents. */
+	readonly othersOnly?: boolean;
+}
+
+/**
+ * Whether the island is on screen. Focus narrows the agents (islandAgents); with none left an island that is only for the
+ * others' agents has nothing to say and hides, whatever the no-agents setting says (an empty pill would only sit there).
+ */
+export function islandVisible(i: VisibilityInput): boolean {
+	return i.hasAgents || !(i.autoHide.noAgents || i.othersOnly);
+}
