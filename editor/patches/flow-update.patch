@@ -0,0 +1,105 @@
+/*---------------------------------------------------------------------------------------------
+ *  Insilode: updates from static JSON files on a GitHub release, instead of Microsoft's update server.
+ *--------------------------------------------------------------------------------------------*/
+
+import type { IUpdate } from '../common/update.js';
+
+/**
+ * The file that describes the newest release for one platform: `<updateUrl>/update-<platform>-<quality>.json`.
+ * With the product's updateUrl on `releases/latest/download`, GitHub redirects it to the newest release's assets.
+ */
+export function createInsilodeUpdateURL(baseUpdateUrl: string, platform: string, quality: string): string {
+	return `${baseUpdateUrl.replace(/\/+$/, '')}/update-${platform}-${quality}.json`;
+}
+
+/**
+ * The environment may point the updater at another folder of update files (a local server, to test an update). Only
+ * https, or http on this machine, is accepted: anything else keeps the product's own URL.
+ */
+export function resolveInsilodeUpdateBaseUrl(productUpdateUrl: string, override: string | undefined): string {
+	if (override) {
+		try {
+			const url = new URL(override);
+			const local = url.hostname === 'localhost' || url.hostname === '127.0.0.1' || url.hostname === '[::1]';
+			if (url.protocol === 'https:' || (url.protocol === 'http:' && local)) {
+				return override;
+			}
+		} catch {
+			// not a URL: ignore it
+		}
+	}
+	return productUpdateUrl;
+}
+
+interface IParsedVersion {
+	readonly numbers: readonly number[];
+	readonly prerelease: readonly string[];
+}
+
+function parseVersion(version: string): IParsedVersion | undefined {
+	const match = /^v?(\d+(?:\.\d+)*)(?:-([0-9A-Za-z.-]+))?(?:\+[0-9A-Za-z.-]+)?$/.exec(version.trim());
+	if (!match) {
+		return undefined;
+	}
+	return { numbers: match[1].split('.').map(Number), prerelease: match[2] ? match[2].split('.') : [] };
+}
+
+function comparePrerelease(a: readonly string[], b: readonly string[]): number {
+	// A release is newer than any of its prereleases.
+	if (!a.length || !b.length) {
+		return a.length === b.length ? 0 : a.length ? -1 : 1;
+	}
+	for (let i = 0; i < Math.max(a.length, b.length); i++) {
+		if (a[i] === undefined) {
+			return -1;
+		}
+		if (b[i] === undefined) {
+			return 1;
+		}
+		const aNumeric = /^\d+$/.test(a[i]);
+		const bNumeric = /^\d+$/.test(b[i]);
+		if (aNumeric && bNumeric) {
+			if (Number(a[i]) !== Number(b[i])) {
+				return Number(a[i]) < Number(b[i]) ? -1 : 1;
+			}
+		} else if (aNumeric !== bNumeric) {
+			return aNumeric ? -1 : 1;
+		} else if (a[i] !== b[i]) {
+			return a[i] < b[i] ? -1 : 1;
+		}
+	}
+	return 0;
+}
+
+/** Semver order: negative when a is older than b, 0 when equal, `undefined` when either is not a version. */
+export function compareVersions(a: string, b: string): number | undefined {
+	const left = parseVersion(a);
+	const right = parseVersion(b);
+	if (!left || !right) {
+		return undefined;
+	}
+	for (let i = 0; i < Math.max(left.numbers.length, right.numbers.length); i++) {
+		const l = left.numbers[i] ?? 0;
+		const r = right.numbers[i] ?? 0;
+		if (l !== r) {
+			return l < r ? -1 : 1;
+		}
+	}
+	return comparePrerelease(left.prerelease, right.prerelease);
+}
+
+/**
+ * What the update file says, as an update, or `null` when there is nothing to install: no file content, a missing
+ * field, a version that is not newer than this one (the static file has no 204 to say so) or one that is not a version.
+ */
+export function parseInsilodeUpdate(raw: unknown, currentVersion: string): IUpdate | null {
+	if (!raw || typeof raw !== 'object') {
+		return null;
+	}
+	const update = raw as IUpdate;
+	if (!update.url || !update.version || !update.productVersion) {
+		return null;
+	}
+	const order = compareVersions(update.productVersion, currentVersion);
+	return order !== undefined && order > 0 ? update : null;
+}
