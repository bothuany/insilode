+.monaco-workbench.modern-ui .interactive-session .chat-welcome-view > :is(.chat-welcome-view-icon, .chat-welcome-view-title, .chat-welcome-view-message, .chat-welcome-view-disclaimer, .chat-welcome-view-tips) {
